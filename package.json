{
  "name": "homebridge-switchbot-simple",
  "displayName": "SwitchBot Simple",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A small Homebridge dynamic platform for SwitchBot OpenAPI switches.",
  "author": "",
  "license": "Apache-2.0",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "switchbot"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "test": "npm run build && node --test dist/*.test.js",
    "test:integration": "npm run build && node --test test/integration.mjs"
  },
  "dependencies": {
    "homebridge-lib": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
